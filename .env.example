# ── Database ────────────────────────────────────────────────────────────────────
# docker compose up -d db  →  postgres with pgvector on localhost:5433
QANOUN_DB_URL=postgresql+psycopg://qanoun:qanoun@localhost:5433/qanoun

# ── LLM providers ──────────────────────────────────────────────────────────────
# Keys live HERE, on the server — never in the browser. The settings dialog (⚙) only
# chooses among the providers configured below; questions fall back automatically to the
# next configured provider when one is down or rate-limited.
#
# Local OpenAI-compatible server (always available as a fallback):
#   LM Studio:  http://localhost:1234/v1   (Developer tab → Start server)
#   Ollama:     http://localhost:11434/v1  (ollama serve; ollama pull qwen2.5:7b)
QANOUN_LLM_URL=http://localhost:1234/v1
QANOUN_LLM_MODEL=
QANOUN_LLM_KEY=

# Cloud providers — set a key to enable one. *_MODEL is optional: empty picks a current
# chat model from the provider's live model list.
# Google Gemini (free tier, strong Arabic):  https://aistudio.google.com/apikey
QANOUN_GEMINI_KEY=
QANOUN_GEMINI_MODEL=
# OpenRouter (free ":free" models):          https://openrouter.ai/keys
QANOUN_OPENROUTER_KEY=
QANOUN_OPENROUTER_MODEL=
# NVIDIA NIM (free credits):                 https://build.nvidia.com/
QANOUN_NVIDIA_KEY=
QANOUN_NVIDIA_MODEL=

# Preferred provider id: local | gemini | openrouter | nvidia
# (empty = the first cloud provider with a key, else local)
QANOUN_LLM_PROVIDER=

# ── Embeddings ─────────────────────────────────────────────────────────────────
# sentence-transformers model; bge-m3 is multilingual and strong on Arabic.
QANOUN_EMBED_MODEL=BAAI/bge-m3
# The free Vercel demo embeds through Jina's API instead (no model on the server):
# QANOUN_EMBED_MODEL=jina-embeddings-v3
# QANOUN_JINA_KEY=
# Serverless hosts allow writes only under /tmp:
# QANOUN_REWRITE_CACHE=/tmp/rewrites.json
# cpu | mps | cuda  (cpu is the most reliable while the LLM also runs locally)
QANOUN_DEVICE=cpu

# ── Hugging Face (embedding model download) ────────────────────────────────────
# A free read token removes the "unauthenticated requests to the HF Hub" warning and
# its lower rate limits: https://huggingface.co/settings/tokens
HF_TOKEN=
# After the first successful start (model cached in ~/.cache/huggingface), uncomment to
# skip the Hub check on every start — faster boot, works offline:
# HF_HUB_OFFLINE=1

# ── API ────────────────────────────────────────────────────────────────────────
QANOUN_API_URL=http://localhost:8000

# ── Retrieval ──────────────────────────────────────────────────────────────────
# Optional cross-encoder reranker over the top 30 hits (slower; see docs/eval-report.md):
# QANOUN_RERANKER=BAAI/bge-reranker-v2-m3
QANOUN_RERANKER=

# ── Accounts (optional; the app works without signing in) ──────────────────────
# Anyone can create an account when true. On a public server set false and create
# users with:  make user EMAIL=you@example.com   (the first user is admin)
QANOUN_ALLOW_SIGNUP=true
# true when served over HTTPS (production): the session cookie is then HTTPS-only.
QANOUN_COOKIE_SECURE=false
# Web origins allowed to call the API with the session cookie (comma-separated).
QANOUN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Production (docker-compose.prod.yml) ───────────────────────────────────────
# POSTGRES_PASSWORD=change-me-long-random
# QANOUN_PUBLIC_API_URL=https://api.qanoun.example.com
